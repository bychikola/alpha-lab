//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  MEAN REVERSION QUANT — v2 · ИНДИКАТОР
//
//  Порт математической модели, отлаженной и проверенной в Python-полигоне
//  Alpha Lab (src/alpha_lab/). Логика перенесена один-в-один, включая
//  последовательную симуляцию выходов, которой в типовых индикаторах нет.
//
//  ВАЖНО О ФОРМАТИРОВАНИИ: ни одно выражение со строковой конкатенацией
//  не разорвано по строкам. Pine разбирает перенесённую через "+" строку
//  как незакрытый литерал (CE10017), поэтому все tooltip и все склейки
//  текста записаны в одну строку, как бы длинно это ни выглядело.
//
//  ─────────────────────────── ЧТО СЧИТАЕТ ───────────────────────────────
//   1. z-скор          z = (close − μ) / σ
//        μ, σ — скользящие, σ по ГЕНЕРАЛЬНОЙ совокупности (ddof = 0).
//        Именно так считает Python: pandas .std(ddof=0). Pine-функция
//        ta.stdev даёт выборочное σ (ddof = 1) — здесь это не подходит,
//        поэтому дисперсия считается вручную.
//
//   2. ATR             сглаживание Уайлдера (RMA, α = 1/len), затравка —
//        среднее первых len истинных диапазонов. Совпадает с ta.atr и с
//        ta.rma в Pine по построению; в Python это отдельно проверено
//        против рекурсии, написанной с нуля (расхождение 0.0).
//
//   3. θ и полужизнь   МНК-регрессия ΔS = a + b·S по окну hlLen:
//        θ = −b,  T½ = ln(2)/θ.  Возврат к среднему есть только при θ > 0.
//
//   4. Вход            z ≤ −k → лонг,  z ≥ +k → шорт.
//        Вход подавляется, если уровень стопа или тейка не определён —
//        позиция без защиты протоколом модели не открывается.
//
//   5. Выходы          ПОСЛЕДОВАТЕЛЬНАЯ симуляция, а не векторная.
//        Стоп и тейк проверяются в ТОМ ЖЕ баре, что и вход (консервативно:
//        бар мог сходить за стоп ещё до входа). Если бар пробил и стоп, и
//        тейк — считается стоп. По истечении maxBars позиция закрывается
//        по времени. Повторный вход в баре выхода не выполняется.
//
//  ────────────────────────────── ПАНЕЛИ ─────────────────────────────────
//   ① «Модель и позиция» — состояние модели и, если позиция открыта,
//      её цена входа, стоп, тейк, текущий нереализованный R и удержание.
//   ② «История сделок» — последние N закрытых сделок и статистика по ним.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Mean Reversion Quant v2", shorttitle="MRQ v2", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ─────────────────────────── ① ПАРАМЕТРЫ ────────────────────────────────
grpM = "1. Модель среднего"
winLen = input.int(20, "Окно среднего и сигмы, баров", minval=2, maxval=500, group=grpM, tooltip="Окно скользящего среднего и стандартного отклонения. Также задаёт длину истории, нужную решению: до бара winLen-1 сигналов нет.")
kEntry = input.float(2.0, "Порог входа k, сигм", minval=0.5, maxval=5.0, step=0.1, group=grpM, tooltip="Вход при |z| >= k. Учтите: на персистентном ряде скользящий z имеет сигму больше 1, поэтому порог срабатывает реже, чем два сигма.")
showBands = input.bool(true, "Показывать полосы mu +/- k*sigma", group=grpM)
bandK = input.float(2.0, "Множитель полос", minval=0.5, maxval=4.0, step=0.1, group=grpM, tooltip="Только для визуализации; на входы не влияет.")

grpR = "2. Риск и выходы"
atrLen = input.int(14, "ATR период", minval=2, maxval=100, group=grpR)
slAtr = input.float(2.0, "Стоп, x ATR", minval=0.1, maxval=20.0, step=0.1, group=grpR)
tpAtr = input.float(6.0, "Тейк, x ATR", minval=0.1, maxval=50.0, step=0.1, group=grpR, tooltip="Отношение тейк/стоп задаёт потолок R на сделку: 6/2 = 3R.")
maxBars = input.int(500, "Макс. удержание, баров", minval=1, maxval=100000, group=grpR, tooltip="Принудительный выход по времени, если ни стоп, ни тейк не сработали.")

grpH = "3. Фильтр полужизни OU"
useHL = input.bool(false, "Включить фильтр полужизни", group=grpH, tooltip="Входы только там, где ряд статистически возвращается к среднему. По умолчанию выключен — как в проверенной конфигурации.")
hlLen = input.int(200, "Окно оценки theta", minval=20, maxval=2000, group=grpH)
hlMin = input.float(5.0, "Мин. полужизнь, баров", minval=0.5, maxval=1000.0, group=grpH)
hlMax = input.float(100.0, "Макс. полужизнь, баров", minval=1.0, maxval=5000.0, group=grpH)

grpV = "4. Визуализация"
showEntry = input.bool(true, "Метки входов", group=grpV)
showExit = input.bool(true, "Метки выходов", group=grpV)
showLevels = input.bool(true, "Линии стоп/тейк активной позиции", group=grpV)
showBg = input.bool(true, "Фон по направлению позиции", group=grpV)
showState = input.bool(true, "Панель Модель и позиция", group=grpV)
showHist = input.bool(true, "Панель История сделок", group=grpV)
histRows = input.int(10, "Сделок в истории", minval=1, maxval=12, group=grpV, tooltip="Сколько последних закрытых сделок показывать в таблице истории.")

// ─────────────────────────── ② ЯДРО МОДЕЛИ ───────────────────────────────
// Среднее и сигма. Дисперсия генеральная (ddof = 0), как в Python.
// ta.stdev сюда не годится: он выборочный (ddof = 1).
mean = ta.sma(close, winLen)
meanSq = ta.sma(close * close, winLen)
variance = meanSq - mean * mean
sigma = math.sqrt(math.max(variance, 0.0))

// sigma ~ 0 или прогрев -> z = 0.0, как fillna(0.0) в Python.
zRaw = not na(sigma) and sigma > 1e-12 ? (close - mean) / sigma : 0.0
z = na(zRaw) ? 0.0 : zRaw

// ATR Уайлдера: ta.atr = ta.rma(ta.tr(true), len) с затравкой средним
// первых len диапазонов. Ту же рекурсию реализует Python.
atrVal = ta.atr(atrLen)

// МНК-регрессия dS = a + b*S по окну hlLen -> theta = -b, T1/2 = ln(2)/theta.
dS = close - close[1]
sPrev = close[1]
sumX = math.sum(sPrev, hlLen)
sumY = math.sum(dS, hlLen)
sumXY = math.sum(sPrev * dS, hlLen)
sumXX = math.sum(sPrev * sPrev, hlLen)
denom = hlLen * sumXX - sumX * sumX
bSlope = denom != 0 ? (hlLen * sumXY - sumX * sumY) / denom : na
theta = not na(bSlope) and bSlope < 0 ? -bSlope : na
halfLife = na(theta) ? na : math.log(2) / theta
hlOk = not useHL or (not na(halfLife) and halfLife >= hlMin and halfLife <= hlMax)

// ─────────────────────────── ③ УРОВНИ И СИГНАЛЫ ──────────────────────────
slLong = close - slAtr * atrVal
tpLong = close + tpAtr * atrVal
slShort = close + slAtr * atrVal
tpShort = close - tpAtr * atrVal

// Прогрев: решение доступно с бара, где готовы и окно, и ATR.
ready = bar_index >= math.max(winLen, atrLen) - 1

// Подавление входа при неопределённом уровне защиты: позиция без стопа
// протоколом модели не открывается.
longProtected = not na(slLong) and not na(tpLong)
shortProtected = not na(slShort) and not na(tpShort)

wantLong = ready and hlOk and longProtected and z <= -kEntry
wantShort = ready and hlOk and shortProtected and z >= kEntry

// ─────────────── ④ ПОСЛЕДОВАТЕЛЬНАЯ СИМУЛЯЦИЯ ВЫХОДОВ ───────────────────
// Точный перенос _simulate_py. Порядок внутри бара: сначала возможный вход,
// затем проверка стопа и тейка В ТОМ ЖЕ баре. Если диапазон бара входа уже
// пробил стоп, записывать позицию удержанной — значит занижать убыток.
var int   gDir      = 0
var float gEntryP   = na
var float gStopP    = na
var float gTakeP    = na
var float gRiskP    = na
var int   gEntryBar = na

var int   gTrades  = 0
var int   gWins    = 0
var float gSumR    = 0.0
var int   gStopN   = 0
var int   gTakeN   = 0
var int   gTimeN   = 0
var int   gHoldSum = 0
var float gBestR   = na
var float gWorstR  = na

// Последняя ЗАКРЫТАЯ сделка. Нужна потому, что таблица рисуется только на
// последнем баре, а модель большую часть времени вне рынка: без этой памяти
// блок позиции показывал бы прочерки почти всегда, и выглядело бы это как
// поломка, а не как «сейчас позиции нет».
var float zEntry = na
var float zExit  = na
var float zSl    = na
var float zTp    = na
var float zR     = na
var int   zKind  = 0
var int   zBars  = 0

var bool  fEnteredLong  = false
var bool  fEnteredShort = false
var bool  fExited       = false
var int   fExitKind     = 0
var int   fHoldBars     = 0
var float fExitP        = na

// Хранилище закрытых сделок: параллельные массивы одной длины.
var array<int>   hDir   = array.new_int()
var array<float> hEntry = array.new_float()
var array<float> hExit  = array.new_float()
var array<float> hR     = array.new_float()
var array<int>   hKind  = array.new_int()

fEnteredLong  := false
fEnteredShort := false
fExited       := false
fExitKind     := 0
fHoldBars     := 0
fExitP        := na

if gDir == 0 and wantLong
    gDir      := 1
    gEntryBar := bar_index
    gEntryP   := close
    gStopP    := slLong
    gTakeP    := tpLong
    gRiskP    := slAtr * atrVal
    fEnteredLong := true
else if gDir == 0 and wantShort
    gDir      := -1
    gEntryBar := bar_index
    gEntryP   := close
    gStopP    := slShort
    gTakeP    := tpShort
    gRiskP    := slAtr * atrVal
    fEnteredShort := true

if gDir != 0
    bool hitSL = gDir > 0 ? low <= gStopP : high >= gStopP
    bool hitTP = gDir > 0 ? high >= gTakeP : low <= gTakeP
    bool timeUp = (bar_index - gEntryBar) >= maxBars

    // Приоритет как в Python: стоп ИЛИ таймаут старше тейка. Признак
    // выхода, цена выхода и зачёт выигрыша обязаны следовать одному
    // порядку, иначе R посчитается по цене тейка при выходе по времени.
    bool closed = hitSL or timeUp or hitTP
    if closed
        int   kind  = hitSL ? 1 : timeUp ? 3 : 2
        float exitP = hitSL ? gStopP : timeUp ? close : gTakeP
        float rMult = gDir > 0 ? (exitP - gEntryP) / gRiskP : (gEntryP - exitP) / gRiskP
        int   bars  = bar_index - gEntryBar

        fExitKind := kind
        fExited   := true
        fExitP    := exitP
        fHoldBars := bars

        gTrades  += 1
        gWins    += kind == 2 ? 1 : 0
        gHoldSum += bars
        gSumR    += rMult
        gStopN   += kind == 1 ? 1 : 0
        gTakeN   += kind == 2 ? 1 : 0
        gTimeN   += kind == 3 ? 1 : 0
        gBestR   := na(gBestR) ? rMult : math.max(gBestR, rMult)
        gWorstR  := na(gWorstR) ? rMult : math.min(gWorstR, rMult)

        zEntry := gEntryP
        zExit  := exitP
        zSl    := gStopP
        zTp    := gTakeP
        zR     := rMult
        zKind  := kind
        zBars  := bars

        array.push(hDir, gDir)
        array.push(hEntry, gEntryP)
        array.push(hExit, exitP)
        array.push(hR, rMult)
        array.push(hKind, kind)

        gDir := 0

// Позиция, удерживаемая в этом баре. При выходе — ноль.
posNow = gDir

// Нереализованный R текущей позиции — от текущей цены, не от выхода.
float liveR = na
if gDir != 0 and not na(gRiskP) and gRiskP > 0
    liveR := gDir > 0 ? (close - gEntryP) / gRiskP : (gEntryP - close) / gRiskP

// ─────────────────────────── ⑤ ВИЗУАЛИЗАЦИЯ ─────────────────────────────
pMean = plot(mean, "Среднее", color.new(color.orange, 0), 1)
pUp = plot(showBands ? mean + bandK * sigma : na, "Верхняя полоса", color.new(color.orange, 55), 1)
pDn = plot(showBands ? mean - bandK * sigma : na, "Нижняя полоса", color.new(color.orange, 55), 1)
fill(pUp, pDn, color=showBands ? color.new(color.orange, 93) : na, title="Канал")

bgcolor(showBg and posNow > 0 ? color.new(color.teal, 92) : showBg and posNow < 0 ? color.new(color.maroon, 92) : na, title="Фон позиции")

plotshape(showEntry and fEnteredLong, "Вход в лонг", shape.triangleup, location.belowbar, color.new(color.teal, 0), size=size.tiny)
plotshape(showEntry and fEnteredShort, "Вход в шорт", shape.triangledown, location.abovebar, color.new(color.maroon, 0), size=size.tiny)

// location.absolute берёт координату Y из значения серии, поэтому булев флаг
// нарисовал бы метку на уровне 1.0. Передаём цену выхода.
plotshape(showExit and fExited and fExitKind == 1 ? fExitP : na, "Выход стоп", shape.xcross, location.absolute, color.new(color.red, 0), size=size.tiny)
plotshape(showExit and fExited and fExitKind == 2 ? fExitP : na, "Выход тейк", shape.xcross, location.absolute, color.new(color.green, 0), size=size.tiny)
plotshape(showExit and fExited and fExitKind == 3 ? fExitP : na, "Выход время", shape.circle, location.absolute, color.new(color.gray, 0), size=size.tiny)

// Линии защиты активной позиции.
//
// ВАЖНО: line.new создаёт НОВУЮ линию, а старая остаётся на графике навсегда.
// Без удаления за 70 сделок накапливается 140 пунктирных линий от давно
// закрытых позиций, и график превращается в кашу. Поэтому линии живут ровно
// столько, сколько открыта позиция: появились на входе, тянутся по барам,
// удаляются на выходе.
var line lnSL = na
var line lnTP = na

if showLevels
    if gDir == 0
        // Позиции нет — линий быть не должно. Ветка самовосстанавливающаяся:
        // если линия почему-то осталась (например, вход и выход на одном баре
        // не дошли до создания), она будет удалена здесь.
        if not na(lnSL)
            line.set_x2(lnSL, bar_index)
            line.set_x2(lnTP, bar_index)
            line.delete(lnSL)
            line.delete(lnTP)
            lnSL := na
            lnTP := na
    else if fEnteredLong or fEnteredShort
        lnSL := line.new(bar_index, gStopP, bar_index + 1, gStopP, color=color.new(color.red, 20), width=1, style=line.style_dashed)
        lnTP := line.new(bar_index, gTakeP, bar_index + 1, gTakeP, color=color.new(color.green, 20), width=1, style=line.style_dashed)
    else if not na(lnSL)
        line.set_x2(lnSL, bar_index + 1)
        line.set_x2(lnTP, bar_index + 1)
    else
        // Позиция открыта, а линий нет — восстановим по текущим уровням.
        lnSL := line.new(bar_index, gStopP, bar_index + 1, gStopP, color=color.new(color.red, 20), width=1, style=line.style_dashed)
        lnTP := line.new(bar_index, gTakeP, bar_index + 1, gTakeP, color=color.new(color.green, 20), width=1, style=line.style_dashed)

// Служебные ряды — в окно данных, не на график.
plot(z, "z-скор", color.new(color.blue, 100), display=display.data_window)
plot(theta, "theta скорость возврата", display=display.data_window)
plot(halfLife, "Полужизнь, баров", display=display.data_window)
plot(posNow, "Позиция", display=display.data_window)
plot(liveR, "Нереализованный R", display=display.data_window)

// ─────────────── ⑥ ПАНЕЛЬ «МОДЕЛЬ И ПОЗИЦИЯ» ─────────────────────────────
var table st = table.new(position.top_right, 2, 12, border_width=1)

if showState and barstate.islast
    table.cell(st, 0, 0, "MRQ v2 модель", text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.small)
    table.cell(st, 1, 0, timeframe.period, text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.small)

    table.cell(st, 0, 1, "z сейчас", text_color=color.gray, text_size=size.small)
    table.cell(st, 1, 1, str.tostring(z, "#.00"), text_color=math.abs(z) >= kEntry ? color.yellow : color.gray, text_size=size.small)

    table.cell(st, 0, 2, "Среднее / сигма", text_color=color.gray, text_size=size.small)
    table.cell(st, 1, 2, str.tostring(mean, format.mintick) + " / " + str.tostring(sigma, format.mintick), text_color=color.gray, text_size=size.small)

    table.cell(st, 0, 3, "ATR " + str.tostring(atrLen), text_color=color.gray, text_size=size.small)
    table.cell(st, 1, 3, na(atrVal) ? "-" : str.tostring(atrVal, format.mintick), text_color=color.gray, text_size=size.small)

    table.cell(st, 0, 4, "theta / полужизнь", text_color=color.gray, text_size=size.small)
    table.cell(st, 1, 4, na(halfLife) ? "нет возврата" : str.tostring(halfLife, "#.#") + " бар", text_color=color.gray, text_size=size.small)

    table.cell(st, 0, 5, "Состояние", text_color=color.gray, text_size=size.small)
    table.cell(st, 1, 5, posNow > 0 ? "ЛОНГ" : posNow < 0 ? "ШОРТ" : "вне рынка", text_color=posNow > 0 ? color.teal : posNow < 0 ? color.maroon : color.gray, text_size=size.small)

    // Блок позиции. Пока позиция открыта — её живые данные; когда закрыта —
    // данные последней закрытой сделки. Прочерки остаются только если сделок
    // ещё не было вовсе.
    bool inPos   = posNow != 0
    bool hasLast = not na(zEntry)
    bool showRow = inPos or hasLast

    string hdr = inPos ? (posNow > 0 ? "ТЕКУЩАЯ ПОЗИЦИЯ · ЛОНГ" : "ТЕКУЩАЯ ПОЗИЦИЯ · ШОРТ") : hasLast ? "ПОСЛЕДНЯЯ СДЕЛКА (закрыта)" : "ПОЗИЦИЙ ЕЩЁ НЕ БЫЛО"
    color hdrBg = inPos ? color.new(posNow > 0 ? color.teal : color.maroon, 75) : color.new(color.blue, 85)
    table.cell(st, 0, 6, hdr, text_color=color.white, bgcolor=hdrBg, text_size=size.small)
    table.cell(st, 1, 6, inPos ? "R " + (na(liveR) ? "-" : str.tostring(liveR, "#.##")) : hasLast ? (zR >= 0 ? "+" : "") + str.tostring(zR, "#.##") + "R" : "", text_color=color.white, bgcolor=hdrBg, text_size=size.small)

    string l7 = inPos ? "Цена входа" : "Цена входа"
    string l8 = inPos ? "Стоп" : "Цена выхода"
    string l9 = inPos ? "Тейк" : "Причина выхода"
    string l10 = inPos ? "Нереализованный R" : "Результат"
    string l11 = "Удержание, баров"

    string v7 = inPos ? str.tostring(gEntryP, format.mintick) : hasLast ? str.tostring(zEntry, format.mintick) : "-"
    string v8 = inPos ? str.tostring(gStopP, format.mintick) + "  " + str.tostring(100.0 * (gStopP - close) / close, "#.##") + "%" : hasLast ? str.tostring(zExit, format.mintick) : "-"
    string v9 = inPos ? str.tostring(gTakeP, format.mintick) + "  " + str.tostring(100.0 * (gTakeP - close) / close, "#.##") + "%" : hasLast ? (zKind == 1 ? "стоп" : zKind == 2 ? "тейк" : "время") : "-"
    string v10 = inPos ? (na(liveR) ? "-" : str.tostring(liveR, "#.##") + "R") : hasLast ? ((zR >= 0 ? "+" : "") + str.tostring(zR, "#.##") + "R") : "-"
    string v11 = inPos ? str.tostring(bar_index - gEntryBar) : hasLast ? str.tostring(zBars) : "-"

    table.cell(st, 0, 7, l7, text_color=color.gray, text_size=size.small)
    table.cell(st, 1, 7, v7, text_color=showRow ? color.white : color.gray, text_size=size.small)

    table.cell(st, 0, 8, l8, text_color=color.gray, text_size=size.small)
    table.cell(st, 1, 8, v8, text_color=inPos ? color.red : showRow ? color.white : color.gray, text_size=size.small)

    table.cell(st, 0, 9, l9, text_color=color.gray, text_size=size.small)
    table.cell(st, 1, 9, v9, text_color=inPos ? color.green : hasLast ? (zKind == 1 ? color.red : zKind == 2 ? color.green : color.gray) : color.gray, text_size=size.small)

    // 0.0, а не 0: в одной тернарной ветке не должно быть int и float —
    // Pine требует одинаковый тип у ветвей.
    float rShow = inPos ? (na(liveR) ? 0.0 : liveR) : hasLast ? zR : 0.0

    table.cell(st, 0, 10, l10, text_color=color.gray, text_size=size.small)
    table.cell(st, 1, 10, v10, text_color=rShow >= 0 ? color.green : color.red, text_size=size.small)

    table.cell(st, 0, 11, l11, text_color=color.gray, text_size=size.small)
    table.cell(st, 1, 11, v11, text_color=showRow ? color.white : color.gray, text_size=size.small)

// ─────────────────── ⑦ ПАНЕЛЬ «ИСТОРИЯ СДЕЛОК» ───────────────────────────
// 1 шапка + 12 строк сделок + 1 шапка статистики + 5 строк = 19 строк.
var table ht = table.new(position.bottom_right, 6, 19, border_width=1)

if showHist and barstate.islast
    table.cell(ht, 0, 0, "N", text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.tiny)
    table.cell(ht, 1, 0, "Напр", text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.tiny)
    table.cell(ht, 2, 0, "Вход", text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.tiny)
    table.cell(ht, 3, 0, "Выход", text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.tiny)
    table.cell(ht, 4, 0, "R", text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.tiny)
    table.cell(ht, 5, 0, "Причина", text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.tiny)

    int n = array.size(hDir)
    int shown = math.min(histRows, n)

    // Последние сделки сверху: идём от конца массива к началу.
    for i = 0 to histRows - 1
        int row = 1 + i
        if i < shown
            int idx = n - 1 - i
            int kind = array.get(hKind, idx)
            float rv = array.get(hR, idx)
            table.cell(ht, 0, row, str.tostring(n - i), text_color=color.gray, text_size=size.tiny)
            table.cell(ht, 1, row, array.get(hDir, idx) > 0 ? "лонг" : "шорт", text_color=array.get(hDir, idx) > 0 ? color.teal : color.maroon, text_size=size.tiny)
            table.cell(ht, 2, row, str.tostring(array.get(hEntry, idx), format.mintick), text_color=color.gray, text_size=size.tiny)
            table.cell(ht, 3, row, str.tostring(array.get(hExit, idx), format.mintick), text_color=color.gray, text_size=size.tiny)
            table.cell(ht, 4, row, str.tostring(rv, "#.##"), text_color=rv >= 0 ? color.green : color.red, text_size=size.tiny)
            table.cell(ht, 5, row, kind == 1 ? "стоп" : kind == 2 ? "тейк" : "время", text_color=kind == 1 ? color.red : kind == 2 ? color.green : color.gray, text_size=size.tiny)
        else
            table.cell(ht, 0, row, "", text_size=size.tiny)
            table.cell(ht, 1, row, "", text_size=size.tiny)
            table.cell(ht, 2, row, "", text_size=size.tiny)
            table.cell(ht, 3, row, "", text_size=size.tiny)
            table.cell(ht, 4, row, "", text_size=size.tiny)
            table.cell(ht, 5, row, "", text_size=size.tiny)

    // Статистика по всем сделкам
    float winRate = gTrades > 0 ? 100.0 * gWins / gTrades : 0.0
    float avgR = gTrades > 0 ? gSumR / gTrades : 0.0
    float avgHold = gTrades > 0 ? gHoldSum / gTrades : 0.0
    string bestTxt = na(gBestR) ? "-" : str.tostring(gBestR, "#.##") + "R"
    string worstTxt = na(gWorstR) ? "-" : str.tostring(gWorstR, "#.##") + "R"

    int base = 13
    table.cell(ht, 0, base, "СТАТИСТИКА", text_color=color.white, bgcolor=color.new(color.blue, 85), text_size=size.tiny)
    table.cell(ht, 1, base, str.tostring(gTrades) + " сделок", text_color=color.white, bgcolor=color.new(color.blue, 85), text_size=size.tiny)
    table.cell(ht, 2, base, "", bgcolor=color.new(color.blue, 85), text_size=size.tiny)
    table.cell(ht, 3, base, "", bgcolor=color.new(color.blue, 85), text_size=size.tiny)
    table.cell(ht, 4, base, "", bgcolor=color.new(color.blue, 85), text_size=size.tiny)
    table.cell(ht, 5, base, "", bgcolor=color.new(color.blue, 85), text_size=size.tiny)

    table.cell(ht, 0, base + 1, "Выигрышей", text_color=color.gray, text_size=size.tiny)
    table.cell(ht, 1, base + 1, str.tostring(gWins) + "  " + str.tostring(winRate, "#.#") + "%", text_color=color.gray, text_size=size.tiny)

    table.cell(ht, 0, base + 2, "Сумма R / средний R", text_color=color.gray, text_size=size.tiny)
    table.cell(ht, 1, base + 2, str.tostring(gSumR, "#.##") + "R / " + str.tostring(avgR, "#.##") + "R", text_color=avgR >= 0 ? color.green : color.red, text_size=size.tiny)

    table.cell(ht, 0, base + 3, "Лучшая / худшая", text_color=color.gray, text_size=size.tiny)
    table.cell(ht, 1, base + 3, bestTxt + " / " + worstTxt, text_color=color.gray, text_size=size.tiny)

    table.cell(ht, 0, base + 4, "Выходы стоп/тейк/время", text_color=color.gray, text_size=size.tiny)
    table.cell(ht, 1, base + 4, str.tostring(gStopN) + " / " + str.tostring(gTakeN) + " / " + str.tostring(gTimeN), text_color=color.gray, text_size=size.tiny)

    table.cell(ht, 0, base + 5, "Среднее удержание", text_color=color.gray, text_size=size.tiny)
    table.cell(ht, 1, base + 5, str.tostring(avgHold, "#.#") + " бар", text_color=color.gray, text_size=size.tiny)
